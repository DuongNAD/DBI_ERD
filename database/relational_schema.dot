digraph RelationalSchema {
    rankdir=LR;
    bgcolor="#FFFFFF";
    splines=ortho;
    nodesep=0.6;
    ranksep=1.1;
    node [fontname="Arial"];
    edge [fontname="Arial Bold", fontsize=10, color="#4A5568", arrowhead=normal, arrowsize=0.7];

