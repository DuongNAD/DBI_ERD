        DNH_MaDon [shape=ellipse, peripheries=1, penwidth=1.5, fillcolor="#FEF3C7", color="#D97706", fontcolor="#78350F", fontsize=10, style="filled,bold", label=<<u>Mã đơn nhập</u>>];
        TH_MaThuoc [shape=ellipse, peripheries=1, penwidth=1.5, fillcolor="#FEF3C7", color="#D97706", fontcolor="#78350F", fontsize=10, style="filled,bold", label=<<u>Mã thuốc</u>>];
        VT_MaVatTu [shape=ellipse, peripheries=1, penwidth=1.5, fillcolor="#FEF3C7", color="#D97706", fontcolor="#78350F", fontsize=10, style="filled,bold", label=<<u>Mã vật tư</u>>];
