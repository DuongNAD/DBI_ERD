graph ERD {
    layout=fdp;
    K=2.2;
    overlap=false;
    splines=true;
    sep="+35";
    esep="+25";

    // Thiết lập chung
    bgcolor="#FFFFFF";
    node [fontname="Arial", fontsize=11, style=filled];
    edge [fontname="Arial Bold", fontsize=11, color="#4A5568", fontcolor="#1A202C", penwidth=1.5, labeldistance=3.0];

    subgraph cluster_Part1 {
        label="Phân hệ Bệnh nhân & Tiếp đón";
        fontname="Arial Bold";
        fontsize=16;
        fontcolor="#2B6CB0";
        style="filled,dashed";
        fillcolor="#F8FAFC";
        color="#2B6CB0";
        penwidth=2.0;

        // Thực thể
        BenhNhan [shape=box, peripheries=1, penwidth=2.0, fillcolor="#EBF8FF", color="#2B6CB0", fontcolor="#1A365D", fontsize=13, style="filled,bold", label="BỆNH NHÂN"];
        BaoHiemYt [shape=box, peripheries=1, penwidth=2.0, fillcolor="#EBF8FF", color="#2B6CB0", fontcolor="#1A365D", fontsize=13, style="filled,bold", label="BẢO HIỂM Y TẾ"];
        LichHen [shape=box, peripheries=1, penwidth=2.0, fillcolor="#EBF8FF", color="#2B6CB0", fontcolor="#1A365D", fontsize=13, style="filled,bold", label="LỊCH HẸN"];
        HoSoNhapVien [shape=box, peripheries=1, penwidth=2.0, fillcolor="#EBF8FF", color="#2B6CB0", fontcolor="#1A365D", fontsize=13, style="filled,bold", label="HỒ SƠ NHẬP VIỆN"];
        BenhAn [shape=box, peripheries=1, penwidth=2.0, fillcolor="#EBF8FF", color="#2B6CB0", fontcolor="#1A365D", fontsize=13, style="filled,bold", label="BỆNH ÁN"];

        // Thuộc tính khóa
        BN_PatientID [shape=ellipse, peripheries=1, penwidth=1.5, fillcolor="#FEF3C7", color="#D97706", fontcolor="#78350F", fontsize=10, style="filled,bold", label=<<u>Mã bệnh nhân</u>>];
        BH_InsuranceID [shape=ellipse, peripheries=1, penwidth=1.5, fillcolor="#FEF3C7", color="#D97706", fontcolor="#78350F", fontsize=10, style="filled,bold", label=<<u>Mã bảo hiểm y tế</u>>];
        LH_AppointmentID [shape=ellipse, peripheries=1, penwidth=1.5, fillcolor="#FEF3C7", color="#D97706", fontcolor="#78350F", fontsize=10, style="filled,bold", label=<<u>Mã lịch hẹn</u>>];
        HS_AdmissionID [shape=ellipse, peripheries=1, penwidth=1.5, fillcolor="#FEF3C7", color="#D97706", fontcolor="#78350F", fontsize=10, style="filled,bold", label=<<u>Mã hồ sơ nhập viện</u>>];
        BA_RecordID [shape=ellipse, peripheries=1, penwidth=1.5, fillcolor="#FEF3C7", color="#D97706", fontcolor="#78350F", fontsize=10, style="filled,bold", label=<<u>Mã bệnh án</u>>];

        // Thuộc tính thường
        BN_HoTen [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Họ và tên"];
        BN_NgaySinh [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Ngày sinh"];
        BN_GioiTinh [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Giới tính"];
        BN_SoDienThoai [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Số điện thoại"];
        BN_DiaChi [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Địa chỉ"];
        BN_Email [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Email"];
        BH_MaSoBHYT [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Mã số Bảo hiểm y tế"];
        BH_NhaCungCap [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Nhà cung cấp"];
        BH_NgayHieuLuc [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Ngày hiệu lực"];
        BH_NgayHetHan [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Ngày hết hạn"];
        LH_NgayHen [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Ngày hẹn"];
        LH_GioHen [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Giờ hẹn"];
        LH_TrangThai [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Trạng thái"];
        LH_LyDoKham [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Lý do khám"];
        LH_PatientID_FK [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Mã bệnh nhân (FK)"];
        HS_NgayNhapVien [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Ngày nhập viện"];
        HS_NgayRaVien [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Ngày ra viện"];
        HS_LyDoNhapVien [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Lý do nhập viện"];
        HS_KhoaDieuTri [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Khoa điều trị"];
        HS_TrangThai [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Trạng thái"];
        HS_PatientID_FK [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Mã bệnh nhân (FK)"];
        BA_NgayTao [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Ngày tạo"];
        BA_ChanDoan [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Chẩn đoán"];
        BA_DieuTri [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Điều trị"];
        BA_GhiChu [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Ghi chú"];
        BA_PatientID_FK [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Mã bệnh nhân (FK)"];
        BA_AdmissionID_FK [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled, label="Mã hồ sơ nhập viện (FK)"];

        // Mối quan hệ nội bộ
        CoInsurance [shape=diamond, peripheries=1, penwidth=1.5, fillcolor="#FAF5FF", color="#6B46C1", fontcolor="#4C1D95", fontsize=11, style="filled,bold", label="CÓ"];
        DatAppointment [shape=diamond, peripheries=1, penwidth=1.5, fillcolor="#FAF5FF", color="#6B46C1", fontcolor="#4C1D95", fontsize=11, style="filled,bold", label="ĐẶT"];
        NhapVien [shape=diamond, peripheries=1, penwidth=1.5, fillcolor="#FAF5FF", color="#6B46C1", fontcolor="#4C1D95", fontsize=11, style="filled,bold", label="NHẬP VIỆN"];
        CoRecord [shape=diamond, peripheries=1, penwidth=1.5, fillcolor="#FAF5FF", color="#6B46C1", fontcolor="#4C1D95", fontsize=11, style="filled,bold", label="CÓ"];
        TaoTu [shape=diamond, peripheries=1, penwidth=1.5, fillcolor="#FAF5FF", color="#6B46C1", fontcolor="#4C1D95", fontsize=11, style="filled,bold", label="TẠO TỪ"];

        // Kết nối thuộc tính nội bộ
        BenhNhan -- BN_PatientID;
        BenhNhan -- BN_HoTen;
        BenhNhan -- BN_NgaySinh;
        BenhNhan -- BN_GioiTinh;
        BenhNhan -- BN_SoDienThoai;
        BenhNhan -- BN_DiaChi;
        BenhNhan -- BN_Email;
        BaoHiemYt -- BH_InsuranceID;
        BaoHiemYt -- BH_MaSoBHYT;
        BaoHiemYt -- BH_NhaCungCap;
        BaoHiemYt -- BH_NgayHieuLuc;
        BaoHiemYt -- BH_NgayHetHan;
        LichHen -- LH_AppointmentID;
        LichHen -- LH_NgayHen;
        LichHen -- LH_GioHen;
        LichHen -- LH_TrangThai;
        LichHen -- LH_LyDoKham;
        LichHen -- LH_PatientID_FK;
        HoSoNhapVien -- HS_AdmissionID;
        HoSoNhapVien -- HS_NgayNhapVien;
        HoSoNhapVien -- HS_NgayRaVien;
        HoSoNhapVien -- HS_LyDoNhapVien;
        HoSoNhapVien -- HS_KhoaDieuTri;
        HoSoNhapVien -- HS_TrangThai;
        HoSoNhapVien -- HS_PatientID_FK;
        BenhAn -- BA_RecordID;
        BenhAn -- BA_NgayTao;
        BenhAn -- BA_ChanDoan;
        BenhAn -- BA_DieuTri;
        BenhAn -- BA_GhiChu;
        BenhAn -- BA_PatientID_FK;
        BenhAn -- BA_AdmissionID_FK;

        // Kết nối quan hệ nội bộ
        BenhNhan -- CoInsurance [taillabel="1"];
        CoInsurance -- BaoHiemYt [headlabel="1", color="#4A5568:invis:#4A5568", penwidth=3];
        BenhNhan -- DatAppointment [taillabel="1"];
        DatAppointment -- LichHen [headlabel="N", color="#4A5568:invis:#4A5568", penwidth=3];
        BenhNhan -- NhapVien [taillabel="1"];
        NhapVien -- HoSoNhapVien [headlabel="N", color="#4A5568:invis:#4A5568", penwidth=3];
        BenhNhan -- CoRecord [taillabel="1"];
        CoRecord -- BenhAn [headlabel="N", color="#4A5568:invis:#4A5568", penwidth=3];
        HoSoNhapVien -- TaoTu [taillabel="1"];
        TaoTu -- BenhAn [headlabel="N", color="#4A5568:invis:#4A5568", penwidth=3];
    }

    subgraph cluster_Part2 {
        label="Phân hệ Chẩn đoán & Điều trị";
        fontname="Arial Bold";
        fontsize=16;
        fontcolor="#319795";
        style="filled,dashed";
        fillcolor="#F5FDFD";
        color="#319795";
        penwidth=2.0;

        // Thực thể
        ChanDoan [shape=box, peripheries=1, penwidth=2.0, fillcolor="#E6FFFA", color="#319795", fontcolor="#234E52", fontsize=13, style="filled,bold", label="CHẨN ĐOÁN"];
        DonThuoc [shape=box, peripheries=1, penwidth=2.0, fillcolor="#E6FFFA", color="#319795", fontcolor="#234E52", fontsize=13, style="filled,bold", label="ĐƠN THUỐC"];
        ChiTietDonThuoc [shape=box, peripheries=1, penwidth=2.0, fillcolor="#E6FFFA", color="#319795", fontcolor="#234E52", fontsize=13, style="filled,bold", label="CHI TIẾT ĐƠN THUỐC"];
        PhacDoDieuTri [shape=box, peripheries=1, penwidth=2.0, fillcolor="#E6FFFA", color="#319795", fontcolor="#234E52", fontsize=13, style="filled,bold", label="PHÁC ĐỒ ĐIỀU TRỊ"];
        DichVuYTe [shape=box, peripheries=1, penwidth=2.0, fillcolor="#E6FFFA", color="#319795", fontcolor="#234E52", fontsize=13, style="filled,bold", label="DỊCH VỤ Y TẾ"];

        // Thuộc tính khóa
        CD_MaChanDoan [shape=ellipse, peripheries=1, penwidth=1.5, fillcolor="#FEF3C7", color="#D97706", fontcolor="#78350F", fontsize=10, style="filled,bold", label=<<u>Mã chẩn đoán</u>>];
        DT_MaDonThuoc [shape=ellipse, peripheries=1, penwidth=1.5, fillcolor="#FEF3C7", color="#D97706", fontcolor="#78350F", fontsize=10, style="filled,bold", label=<<u>Mã đơn thuốc</u>>];
        CT_MaChiTiet [shape=ellipse, peripheries=1, penwidth=1.5, fillcolor="#FEF3C7", color="#D97706", fontcolor="#78350F", fontsize=10, style="filled,bold", label=<<u>Mã chi tiết</u>>];
        PD_MaPhacDo [shape=ellipse, peripheries=1, penwidth=1.5, fillcolor="#FEF3C7", color="#D97706", fontcolor="#78350F", fontsize=10, style="filled,bold", label=<<u>Mã phác đồ</u>>];
        DV_MaDichVu [shape=ellipse, peripheries=1, penwidth=1.5, fillcolor="#FEF3C7", color="#D97706", fontcolor="#78350F", fontsize=10, style="filled,bold", label=<<u>Mã dịch vụ</u>>];

        // Thuộc tính thường
        CD_TenChanDoan [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#14532D", fontsize=9, style=filled, label="Tên chẩn đoán"];
        CD_MoTa [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#14532D", fontsize=9, style=filled, label="Mô tả"];
        CD_NgayChanDoan [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#14532D", fontsize=9, style=filled, label="Ngày chẩn đoán"];
        DT_NgayKeDon [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#14532D", fontsize=9, style=filled, label="Ngày kê đơn"];
        DT_GhiChu [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#14532D", fontsize=9, style=filled, label="Ghi chú"];
        CT_SoLuong [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#14532D", fontsize=9, style=filled, label="Số lượng"];
        CT_LieuDung [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#14532D", fontsize=9, style=filled, label="Liều dùng"];
        CT_ThoiGianSuDung [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#14532D", fontsize=9, style=filled, label="Thời gian sử dụng"];
        PD_TenPhacDo [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#14532D", fontsize=9, style=filled, label="Tên phác đồ"];
        PD_MoTa [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#14532D", fontsize=9, style=filled, label="Mô tả"];
        PD_ThoiGianDieuTri [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#14532D", fontsize=9, style=filled, label="Thời gian điều trị"];
        DV_TenDichVu [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#14532D", fontsize=9, style=filled, label="Tên dịch vụ"];
        DV_MoTa [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#14532D", fontsize=9, style=filled, label="Mô tả"];
        DV_LoaiDichVu [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#14532D", fontsize=9, style=filled, label="Loại dịch vụ"];

        // Mối quan hệ nội bộ
        CoDonThuoc [shape=diamond, peripheries=1, penwidth=1.5, fillcolor="#FAF5FF", color="#6B46C1", fontcolor="#4C1D95", fontsize=11, style="filled,bold", label="CÓ\nĐƠN THUỐC"];
        CoChiTiet [shape=diamond, peripheries=1, penwidth=1.5, fillcolor="#FAF5FF", color="#6B46C1", fontcolor="#4C1D95", fontsize=11, style="filled,bold", label="CÓ\nCHI TIẾT"];
        CoPhacDo [shape=diamond, peripheries=1, penwidth=1.5, fillcolor="#FAF5FF", color="#6B46C1", fontcolor="#4C1D95", fontsize=11, style="filled,bold", label="CÓ\nPHÁC ĐỒ ĐIỀU TRỊ"];
        SuDung [shape=diamond, peripheries=1, penwidth=1.5, fillcolor="#FAF5FF", color="#6B46C1", fontcolor="#4C1D95", fontsize=11, style="filled,bold", label="SỬ DỤNG"];

        // Kết nối thuộc tính nội bộ
        ChanDoan -- CD_MaChanDoan;
        ChanDoan -- CD_TenChanDoan;
        ChanDoan -- CD_MoTa;
        ChanDoan -- CD_NgayChanDoan;
        DonThuoc -- DT_MaDonThuoc;
        DonThuoc -- DT_NgayKeDon;
        DonThuoc -- DT_GhiChu;
        ChiTietDonThuoc -- CT_MaChiTiet;
        ChiTietDonThuoc -- CT_SoLuong;
        ChiTietDonThuoc -- CT_LieuDung;
        ChiTietDonThuoc -- CT_ThoiGianSuDung;
        PhacDoDieuTri -- PD_MaPhacDo;
        PhacDoDieuTri -- PD_TenPhacDo;
        PhacDoDieuTri -- PD_MoTa;
        PhacDoDieuTri -- PD_ThoiGianDieuTri;
        DichVuYTe -- DV_MaDichVu;
        DichVuYTe -- DV_TenDichVu;
        DichVuYTe -- DV_MoTa;
        DichVuYTe -- DV_LoaiDichVu;

        // Kết nối quan hệ nội bộ
        ChanDoan -- CoDonThuoc [taillabel="1"];
        CoDonThuoc -- DonThuoc [headlabel="N"];
        DonThuoc -- CoChiTiet [taillabel="1"];
        CoChiTiet -- ChiTietDonThuoc [headlabel="N"];
        ChanDoan -- CoPhacDo [taillabel="1"];
        CoPhacDo -- PhacDoDieuTri [headlabel="N"];
        DichVuYTe -- SuDung [taillabel="N"];
        SuDung -- PhacDoDieuTri [headlabel="M"];
    }

    subgraph cluster_Part3 {
        label="Phân hệ Xét nghiệm & Chẩn đoán hình ảnh";
        fontname="Arial Bold";
        fontsize=16;
        fontcolor="#6B46C1";
        style="filled,dashed";
        fillcolor="#FAF5FF";
        color="#6B46C1";
        penwidth=2.0;

        // Thực thể
        ThietBiYTe [shape=box, peripheries=1, penwidth=2.0, fillcolor="#FAF5FF", color="#6B46C1", fontcolor="#4C1D95", fontsize=13, style="filled,bold", label="THIẾT BỊ Y TẾ"];
        DanhMucXetNghiem [shape=box, peripheries=1, penwidth=2.0, fillcolor="#FAF5FF", color="#6B46C1", fontcolor="#4C1D95", fontsize=13, style="filled,bold", label="DANH MỤC XÉT NGHIỆM"];
        MauBenhPham [shape=box, peripheries=1, penwidth=2.0, fillcolor="#FAF5FF", color="#6B46C1", fontcolor="#4C1D95", fontsize=13, style="filled,bold", label="MẪU BỆNH PHẨM"];
        KetQuaXetNghiem [shape=box, peripheries=1, penwidth=2.0, fillcolor="#FAF5FF", color="#6B46C1", fontcolor="#4C1D95", fontsize=13, style="filled,bold", label="KẾT QUẢ XÉT NGHIỆM"];
        ChanDoanHinhAnh [shape=box, peripheries=1, penwidth=2.0, fillcolor="#FAF5FF", color="#6B46C1", fontcolor="#4C1D95", fontsize=13, style="filled,bold", label="CHẨN ĐOÁN HÌNH ẢNH"];

        // Thuộc tính khóa
        TB_DeviceID [shape=ellipse, peripheries=1, penwidth=1.5, fillcolor="#FEF3C7", color="#D97706", fontcolor="#78350F", fontsize=10, style="filled,bold", label=<<u>Mã thiết bị</u>>];
        DM_TestID [shape=ellipse, peripheries=1, penwidth=1.5, fillcolor="#FEF3C7", color="#D97706", fontcolor="#78350F", fontsize=10, style="filled,bold", label=<<u>Mã xét nghiệm</u>>];
        BP_SampleID [shape=ellipse, peripheries=1, penwidth=1.5, fillcolor="#FEF3C7", color="#D97706", fontcolor="#78350F", fontsize=10, style="filled,bold", label=<<u>Mã mẫu bệnh phẩm</u>>];
        KQ_ResultID [shape=ellipse, peripheries=1, penwidth=1.5, fillcolor="#FEF3C7", color="#D97706", fontcolor="#78350F", fontsize=10, style="filled,bold", label=<<u>Mã kết quả xét nghiệm</u>>];
        HA_ImagingID [shape=ellipse, peripheries=1, penwidth=1.5, fillcolor="#FEF3C7", color="#D97706", fontcolor="#78350F", fontsize=10, style="filled,bold", label=<<u>Mã hình ảnh</u>>];

        // Thuộc tính thường
        TB_TenThietBi [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#FDF4FF", color="#D8B4FE", fontcolor="#581C87", fontsize=9, style=filled, label="Tên thiết bị"];
        TB_LoaiThietBi [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#FDF4FF", color="#D8B4FE", fontcolor="#581C87", fontsize=9, style=filled, label="Loại thiết bị"];
        TB_HangSanXuat [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#FDF4FF", color="#D8B4FE", fontcolor="#581C87", fontsize=9, style=filled, label="Hãng sản xuất"];
