        DNH_NguoiLap [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#FFF1F2", color="#FDA4AF", fontcolor="#9F1239", fontsize=9, style=filled, label="Người lập"];
        TH_TenThuongMai [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#FFF1F2", color="#FDA4AF", fontcolor="#9F1239", fontsize=9, style=filled, label="Tên thương mại"];
