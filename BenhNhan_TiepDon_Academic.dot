graph ERD {
    layout=fdp;
    K=2.2;
    overlap=false;
    splines=true;
    sep="+35";
    esep="+25";

    // Thiết lập chung
    bgcolor="#FFFFFF";
    node [fontname="Arial", fontsize=11, style=filled];
    edge [fontname="Arial Bold", fontsize=11, color="#4A5568", fontcolor="#1A202C", penwidth=1.5, labeldistance=3.0];

    subgraph cluster_Part1 {
        label="Phân hệ Bệnh nhân & Tiếp đón";
        fontname="Arial Bold";
        fontsize=16;
        fontcolor="#2B6CB0";
        style="filled,dashed";
        fillcolor="#F8FAFC";
        color="#2B6CB0";
        penwidth=2.0;

        // Thực thể
        node [shape=box, peripheries=1, penwidth=2.0, fillcolor="#EBF8FF", color="#2B6CB0", fontcolor="#1A365D", fontsize=13, style="filled,bold"];
        BenhNhan [label="BỆNH NHÂN"];
        BaoHiemYt [label="BẢO HIỂM Y TẾ"];
        LichHen [label="LỊCH HẸN"];
        HoSoNhapVien [label="HỒ SƠ NHẬP VIỆN"];
        BenhAn [label="BỆNH ÁN"];

        // Thuộc tính khóa
        node [shape=ellipse, peripheries=1, penwidth=1.5, fillcolor="#FEF3C7", color="#D97706", fontcolor="#78350F", fontsize=10, style="filled,bold"];
        BN_PatientID [label=<<u>Mã bệnh nhân</u>>];
        BH_InsuranceID [label=<<u>Mã bảo hiểm y tế</u>>];
        LH_AppointmentID [label=<<u>Mã lịch hẹn</u>>];
        HS_AdmissionID [label=<<u>Mã hồ sơ nhập viện</u>>];
        BA_RecordID [label=<<u>Mã bệnh án</u>>];

        // Thuộc tính thường
        node [shape=ellipse, peripheries=1, penwidth=1.0, fillcolor="#F0F9FF", color="#93C5FD", fontcolor="#1E3A8A", fontsize=9, style=filled];
        BN_HoTen [label="Họ và tên"];
        BN_NgaySinh [label="Ngày sinh"];
        BN_GioiTinh [label="Giới tính"];
        BN_SoDienThoai [label="Số điện thoại"];
        BN_DiaChi [label="Địa chỉ"];
        BN_Email [label="Email"];
        BH_MaSoBHYT [label="Mã số Bảo hiểm y tế"];
        BH_NhaCungCap [label="Nhà cung cấp"];
        BH_NgayHieuLuc [label="Ngày hiệu lực"];
        BH_NgayHetHan [label="Ngày hết hạn"];
        LH_NgayHen [label="Ngày hẹn"];
        LH_GioHen [label="Giờ hẹn"];
        LH_TrangThai [label="Trạng thái"];
        LH_LyDoKham [label="Lý do khám"];
        LH_PatientID_FK [label="Mã bệnh nhân (FK)"];
        HS_NgayNhapVien [label="Ngày nhập viện"];
        HS_NgayRaVien [label="Ngày ra viện"];
        HS_LyDoNhapVien [label="Lý do nhập viện"];
        HS_KhoaDieuTri [label="Khoa điều trị"];
        HS_TrangThai [label="Trạng thái"];
        HS_PatientID_FK [label="Mã bệnh nhân (FK)"];
        BA_NgayTao [label="Ngày tạo"];
        BA_ChanDoan [label="Chẩn đoán"];
        BA_DieuTri [label="Điều trị"];
        BA_GhiChu [label="Ghi chú"];
        BA_PatientID_FK [label="Mã bệnh nhân (FK)"];
        BA_AdmissionID_FK [label="Mã hồ sơ nhập viện (FK)"];

        // Mối quan hệ
        node [shape=diamond, peripheries=1, penwidth=1.5, fillcolor="#FAF5FF", color="#6B46C1", fontcolor="#4C1D95", fontsize=11, style="filled,bold"];
        CoInsurance [label="CÓ"];
        DatAppointment [label="ĐẶT"];
        NhapVien [label="NHẬP VIỆN"];
        CoRecord [label="CÓ"];
        TaoTu [label="TẠO TỪ"];

        // Kết nối Thuộc tính
        BenhNhan -- BN_PatientID;
        BenhNhan -- BN_HoTen;
        BenhNhan -- BN_NgaySinh;
        BenhNhan -- BN_GioiTinh;
        BenhNhan -- BN_SoDienThoai;
        BenhNhan -- BN_DiaChi;
        BenhNhan -- BN_Email;
        BaoHiemYt -- BH_InsuranceID;
        BaoHiemYt -- BH_MaSoBHYT;
        BaoHiemYt -- BH_NhaCungCap;
        BaoHiemYt -- BH_NgayHieuLuc;
        BaoHiemYt -- BH_NgayHetHan;
        LichHen -- LH_AppointmentID;
        LichHen -- LH_NgayHen;
        LichHen -- LH_GioHen;
        LichHen -- LH_TrangThai;
        LichHen -- LH_LyDoKham;
        LichHen -- LH_PatientID_FK;
        HoSoNhapVien -- HS_AdmissionID;
        HoSoNhapVien -- HS_NgayNhapVien;
        HoSoNhapVien -- HS_NgayRaVien;
        HoSoNhapVien -- HS_LyDoNhapVien;
        HoSoNhapVien -- HS_KhoaDieuTri;
        HoSoNhapVien -- HS_TrangThai;
        HoSoNhapVien -- HS_PatientID_FK;
        BenhAn -- BA_RecordID;
        BenhAn -- BA_NgayTao;
        BenhAn -- BA_ChanDoan;
        BenhAn -- BA_DieuTri;
        BenhAn -- BA_GhiChu;
        BenhAn -- BA_PatientID_FK;
        BenhAn -- BA_AdmissionID_FK;

        // Kết nối Mối quan hệ
        BenhNhan -- CoInsurance [taillabel="1"];
        CoInsurance -- BaoHiemYt [headlabel="1", color="#4A5568:invis:#4A5568", penwidth=3];
        BenhNhan -- DatAppointment [taillabel="1"];
        DatAppointment -- LichHen [headlabel="N", color="#4A5568:invis:#4A5568", penwidth=3];
        BenhNhan -- NhapVien [taillabel="1"];
        NhapVien -- HoSoNhapVien [headlabel="N", color="#4A5568:invis:#4A5568", penwidth=3];
        BenhNhan -- CoRecord [taillabel="1"];
        CoRecord -- BenhAn [headlabel="N", color="#4A5568:invis:#4A5568", penwidth=3];
        HoSoNhapVien -- TaoTu [taillabel="1"];
        TaoTu -- BenhAn [headlabel="N", color="#4A5568:invis:#4A5568", penwidth=3];
    }
}